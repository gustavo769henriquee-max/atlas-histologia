@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

.admin-page {
  min-height: 100vh;
  background: #f5f7f6;
  color: #17211f;
  font-family: Inter, Arial, sans-serif;
}

.admin-header {
  height: 76px;
  background: white;
  border-bottom: 1px solid #e5e9e7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
}

.admin-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-logo {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1e6f5c;
  color: white;
  text-decoration: none;
  font-size: 21px;
}

.admin-brand strong {
  display: block;
  font-size: 16px;
}

.admin-brand small {
  display: block;
  margin-top: 3px;
  color: #78827f;
  font-size: 12px;
}

.admin-user {
  display: flex;
  align-items: center;
  gap: 18px;
  color: #68736f;
  font-size: 13px;
}

.admin-logout {
  border: 0;
  background: #f0f3f2;
  color: #25312d;
  padding: 9px 15px;
  border-radius: 9px;
  cursor: pointer;
  font-weight: 600;
}

.admin-layout {
  display: flex;
  min-height: calc(100vh - 76px);
}

.admin-sidebar {
  width: 230px;
  flex-shrink: 0;
  background: #102f29;
  padding: 24px 14px;
  display: flex;
  flex-direction: column;
}

.admin-menu {
  width: 100%;
  border: 0;
  background: transparent;
  color: #b9c8c3;
  padding: 13px 15px;
  border-radius: 10px;
  margin-bottom: 5px;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  text-align: left;
  font-size: 14px;
}

.admin-menu:hover {
  background: rgba(255,255,255,.08);
  color: white;
}

.admin-menu.active {
  background: #1e6f5c;
  color: white;
}

.admin-sidebar-bottom {
  margin-top: auto;
  padding: 15px 5px 5px;
}

.admin-sidebar-bottom a {
  color: #aebdb8;
  text-decoration: none;
  font-size: 13px;
}

.admin-content {
  flex: 1;
  padding: 42px;
  max-width: 1300px;
}

.admin-section {
  display: none;
}

.admin-section.active {
  display: block;
}

.admin-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 30px;
}

.admin-title-row h1 {
  margin: 6px 0 8px;
  font-size: 34px;
  letter-spacing: -1px;
}

.admin-title-row p {
  margin: 0;
  color: #707b77;
}

.eyebrow {
  color: #1e6f5c;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.admin-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 25px;
}

.admin-stat {
  background: white;
  border: 1px solid #e5e9e7;
  border-radius: 14px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.admin-stat > span {
  width: 42px;
  height: 42px;
  border-radius: 11px;
  background: #edf5f2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-stat strong {
  display: block;
  font-size: 24px;
}

.admin-stat small {
  color: #7a8581;
}

.admin-toolbar {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.admin-search {
  flex: 1;
  background: white;
  border: 1px solid #dfe5e2;
  border-radius: 10px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  gap: 9px;
}

.admin-search input {
  width: 100%;
  border: 0;
  outline: 0;
  padding: 13px 0;
  font: inherit;
}

.admin-toolbar select {
  min-width: 170px;
  border: 1px solid #dfe5e2;
  border-radius: 10px;
  padding: 0 13px;
  background: white;
  color: #26322e;
}

.admin-laminas-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.admin-lamina-card {
  background: white;
  border: 1px solid #e2e7e5;
  border-radius: 14px;
  padding: 14px;
  display: grid;
  grid-template-columns: 150px minmax(0,1fr) auto;
  align-items: center;
  gap: 20px;
}

.admin-lamina-card:hover {
  border-color: #b8cec7;
  box-shadow: 0 8px 25px rgba(20,45,39,.06);
}

.admin-lamina-thumb {
  height: 105px;
  border-radius: 10px;
  overflow: hidden;
  background: #edf1f0;
}

.admin-lamina-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.admin-no-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
}

.admin-lamina-top {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 7px;
}

.admin-category {
  color: #1e6f5c;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
}

.admin-status {
  font-size: 11px;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 20px;
}

.admin-status.published {
  color: #14734d;
  background: #e9f7ef;
}

.admin-status.hidden {
  color: #6f7774;
  background: #eef0ef;
}

.admin-lamina-info h2 {
  margin: 0 0 6px;
  font-size: 18px;
}

.admin-lamina-info p {
  margin: 0;
  color: #747e7b;
  font-size: 13px;
  line-height: 1.5;
  max-width: 650px;
}

.admin-tags {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  margin-top: 9px;
}

.admin-tags span {
  background: #f1f4f3;
  color: #66716d;
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 11px;
}

.admin-lamina-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.admin-action {
  width: 38px;
  height: 38px;
  border: 1px solid #e0e5e3;
  border-radius: 9px;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  text-decoration: none;
  font-size: 15px;
}

.admin-action:hover {
  background: #f1f5f3;
  transform: translateY(-1px);
}

.admin-action.delete:hover {
  background: #fff0f0;
  border-color: #f0caca;
}

.admin-placeholder,
.admin-empty {
  background: white;
  border: 1px solid #e2e7e5;
  border-radius: 16px;
  padding: 60px 30px;
  text-align: center;
}

.admin-placeholder > div,
.admin-empty > div {
  font-size: 42px;
  margin-bottom: 12px;
}

.admin-placeholder h2,
.admin-empty h2 {
  margin: 0 0 8px;
}

.admin-placeholder p,
.admin-empty p {
  color: #737d79;
}

.admin-error {
  margin: 40px;
  padding: 20px;
  background: #fff0f0;
  color: #9b3131;
  border-radius: 10px;
}

@media (max-width: 850px) {

  .admin-sidebar {
    width: 70px;
  }

  .admin-menu {
    justify-content: center;
  }

  .admin-menu span {
    display: none;
  }

  .admin-content {
    padding: 25px;
  }

  .admin-lamina-card {
    grid-template-columns: 100px 1fr;
  }

  .admin-lamina-actions {
    grid-column: 1 / -1;
    justify-content: flex-end;
  }

}

@media (max-width: 600px) {

  .admin-header {
    padding: 0 15px;
  }

  .admin-user span {
    display: none;
  }

  .admin-content {
    padding: 18px;
  }

  .admin-title-row {
    flex-direction: column;
  }

  .admin-stats {
    grid-template-columns: 1fr;
  }

  .admin-toolbar {
    flex-direction: column;
  }

  .admin-lamina-card {
    grid-template-columns: 1fr;
  }

  .admin-lamina-thumb {
    height: 160px;
  }

}
